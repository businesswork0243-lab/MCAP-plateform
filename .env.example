# =============================================
# MCAP PLATFORM — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# =============================================

# Database (Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# AI engine tuning (all optional; the defaults shown are what runs when unset)
# How much of a brand document each agent sees, in characters. A document longer
# than BRAND_BRIEF_THRESHOLD_CHARS is condensed once into a brief instead.
# BRAND_BRIEF_THRESHOLD_CHARS=24000
# BRAND_DOC_CHARS_WRITER=24000
# BRAND_DOC_CHARS_BRAND=12000
# BRAND_DOC_CHARS_QA=12000
# BRAND_DOC_CHARS_VALIDATOR=20000
# QA reads each draft against the whole brand document for claims it does not
# support (one extra call, about 8k tokens). 0 turns it off.
# QA_CLAIM_AUDIT=1
# The rule engine spends one polish pass on medium-severity findings even when a
# draft passes (RULE_ENGINE_POLISH=0 turns it off) and stops iterating after the
# time budget so it cannot run into the pipeline timeout.
# RULE_ENGINE_POLISH=1
# RULE_ENGINE_TIME_BUDGET_SECONDS=120
# Log, at startup, which LLM providers cannot answer. GET /health/providers shows
# the same on demand. 0 turns the startup check off.
# LLM_STARTUP_PROBE=1

# Redis (Upstash)
REDIS_URL=redis://...
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=mcap-uploads
AWS_REGION=us-east-1

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_ENGINE_URL=http://localhost:8000

# Auth
# Generate each with:  openssl rand -base64 48
# These are REQUIRED — docker compose refuses to start without them.
# Changing JWT_SECRET signs everyone out; that is expected after a rotation.
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Self-hosted Postgres (docker-compose)
# REQUIRED. On a deployment that already has a postgres volume, the database
# still holds the OLD password — Postgres only applies this on first init. To
# change it on a live box, set the new value here AND run:
#   docker compose exec postgres psql -U mcap -d mcap_db \
#     -c "ALTER USER mcap WITH PASSWORD 'the_new_password';"
POSTGRES_USER=mcap
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mcap_db

# Comma-separated list of origins allowed to call the API.
# Leave empty to reflect any origin (development only).
CORS_ORIGINS=https://app.example.com,https://www.example.com
